{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true,
    "isolatedModules": true, "resolveJsonModule": true, "esModuleInterop": true,
    "types": ["svelte", "vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "backend/**/*.ts", "local/**/*.ts", "tests/**/*.ts"]
}
