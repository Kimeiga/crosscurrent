{
  "name": "crosscurrent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "npm start",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "server": "node --experimental-transform-types local/server.ts",
    "dev:client": "vite --host 0.0.0.0",
    "start": "node --experimental-transform-types local/server.ts",
    "preview:homepage": "node scripts/build-demo-preview.cjs"
  },
  "dependencies": {
    "svelte": "^5.39.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@types/node": "^22.0.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
